{
  "name": "api",
  "type": "module",
  "scripts": {
    "db:dev": "docker compose up -d",
    "db:down": "docker compose down",
    "dev": "pnpm db:dev && wrangler dev --port 8000",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check": "pnpm check-types && pnpm lint && pnpm format",
    "seed": "pnpx tsx src/scripts/image-product.ts",
    "upload:r2": "./src/scripts/upload-assets-r2.sh",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/clerk-auth": "^3.0.3",
    "@hono/valibot-validator": "^0.5.3",
    "@types/pg": "^8.15.5",
    "drizzle-orm": "^0.43.1",
    "hono": "^4.9.0",
    "pg": "^8.16.3",
    "stripe": "^18.0.0",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250819.0",
    "@package/eslint-config": "workspace:*",
    "@package/prettier-config": "workspace:*",
    "@package/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.33.0",
    "typescript-eslint": "^8.39.0",
    "wrangler": "^4.28.1"
  }
}
